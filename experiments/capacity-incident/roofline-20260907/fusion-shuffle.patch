+    /// The fused output transform must preserve the current f32 MLX operation
+    /// across both production projection widths and both gather row domains.
+    #[test]
+    fn fused_output_hadamard_matches_mlx_for_production_shapes() {
+        let _exec = crate::mlx_exec::acquire();
+
+        let check = |width: i32, ids: &[u32], seed: u64, label: &str| {
+            const EXPERTS: i32 = 4;
+            let rows = i32::try_from(ids.len()).unwrap();
+            let raw = pseudo_random(ids.len() * width as usize, seed);
+            let mid_values: Vec<f32> = raw
+                .into_iter()
+                .enumerate()
+                .map(|(i, value)| {
+                    let unit = f32::from(value) / 32768.0 - 1.0;
+                    match i % 8 {
+                        0 => 0.0,
+                        1 => -0.0,
+                        2 => unit * f32::MIN_POSITIVE,
+                        3 => unit * 1.0e-6,
+                        4 => unit * 0.125,
+                        5 => unit * 2.0,
+                        6 => unit * 128.0,
+                        _ => unit * 1024.0,
+                    }
+                })
+                .collect();
+            let scale_values: Vec<f32> = (0..EXPERTS as usize * width as usize)
+                .map(|i| match i % 5 {
+                    0 => -1.75,
+                    1 => -0.125,
+                    2 => 0.0,
+                    3 => 0.375,
+                    _ => 2.25,
+                })
+                .collect();
+            let mid = Array::from_slice(&mid_values, &[rows, width]);
+            let scales = Array::from_slice(&scale_values, &[EXPERTS, width]);
+            let eids = Array::from_slice(ids, &[rows]);
+
+            let selected_scales = scales.take_axis(&eids, 0).unwrap();
+            let want = had_blockwise(&mid, -1)
+                .unwrap()
+                .multiply(&selected_scales)
+                .unwrap();
+            let got = crate::metal_kernel::eschamoe_scaled_hadamard_output(
+                &mid, &scales, &eids,
+            )
+            .unwrap();
+            eval([&want, &got]).unwrap();
+
+            assert_eq!(got.shape(), [rows, width], "{label}");
+            assert_eq!(got.dtype(), Dtype::Float32, "{label}");
+            let want_values = want.as_slice::<f32>();
+            let got_values = got.as_slice::<f32>();
+            assert!(
+                got_values.iter().all(|value| value.is_finite()),
+                "{label}: fused output contains a non-finite value"
+            );
+            let max_error = got_values
+                .iter()
+                .zip(want_values)
+                .map(|(got, want)| (got - want).abs())
+                .fold(0.0_f32, f32::max);
+            let scale = want_values
+                .iter()
+                .map(|value| value.abs())
+                .fold(1.0_f32, f32::max);
+            let differing = got_values.iter().zip(want_values)
+                .filter(|(got, want)| got.to_bits() != want.to_bits()).count();
+            eprintln!("{label}: differing={differing}/{} max_error={max_error} scale={scale}", got_values.len());
+            assert!(
+                max_error <= scale * 8.0 * f32::EPSILON,
+                "{label}: max error {max_error} exceeds eight f32 ulps at scale {scale}"
+            );
+        };
+
+        // Native gate+up: QMV row domain, repeated and unsorted expert ids.
+        check(1024, &[3, 1, 3, 0, 2, 1], 0xF053_DA7A, "gate_up/QMV");
+        // Native down: scratch row domain, repeated and unsorted expert ids.
+        let ids: Vec<u32> = (0..40_u32).map(|i| (i * 7 + 3) % 4).collect();
+        check(2048, &ids, 0xD0A1_2048, "down/scratch");
+        check(2048, &[3, 1, 3, 0, 2, 1], 0xA031, "down/QMV");
+        check(1024, &ids, 0xA032, "gate_up/scratch");
+    }
