+// ---------------------------------------------------------------------------
+// Eschamoe fused output transform.
+//
+// This is the existing `had_blockwise(y_pre) * sv[e]` operation expressed as
+// one Metal dispatch. The radix-2 definition comes from `eschamoe::had_blockwise`;
+// no third-party source is copied. EschaLabs/escha-mlx (Apache-2.0) independently
+// demonstrates the same dispatch boundary:
+// https://github.com/EschaLabs/escha-mlx/blob/main/escha_mlx/msl.py
+// ---------------------------------------------------------------------------
+
+const ESCHA_SCALED_HADAMARD_OUTPUT_SOURCE: &str = r"
+threadgroup float stage[128];
+
+uint lane = thread_index_in_threadgroup;
+uint block = threadgroup_position_in_grid.y;
+uint row = threadgroup_position_in_grid.z;
+uint column = block * 128u + lane;
+uint offset = row * uint(OUT) + column;
+float value = mid[offset];
+
+// The first five radix-2 stages stay inside one 32-lane SIMD group.
+// Preserve left+right / left-right order, including the upper lane case.
+for (uint stride = 1u; stride < 32u; stride <<= 1u) {
+    float partner = simd_shuffle_xor(value, stride);
+    value = (lane & stride) ? partner - value : value + partner;
+}
+
+// Only the two cross-SIMD-group stages need shared memory. The middle
+// barrier ensures every lane read stage 32 before any lane overwrites it.
+stage[lane] = value;
+threadgroup_barrier(mem_flags::mem_threadgroup);
+float partner = stage[lane ^ 32u];
+value = (lane & 32u) ? partner - value : value + partner;
+threadgroup_barrier(mem_flags::mem_threadgroup);
+stage[lane] = value;
+threadgroup_barrier(mem_flags::mem_threadgroup);
+partner = stage[lane ^ 64u];
+value = (lane & 64u) ? partner - value : value + partner;
+
+// Normalization and scaling remain separate f32 operations.
+float normalized = value * 0.08838834764831845f;
+uint expert = expert_ids[row];
+float selected_scale = expert < uint(E) ? scales[expert * uint(OUT) + column] : 0.0f;
+float weighted = normalized * selected_scale;
+dst[offset] = weighted;
+";
+
+fn create_escha_scaled_hadamard_output_kernel() -> mlx_sys::mlx_fast_metal_kernel {
+    let in_vec = cstr_vec(&[c"mid", c"scales", c"expert_ids"]);
+    let out_vec = cstr_vec(&[c"dst"]);
+    let source = CString::new(ESCHA_SCALED_HADAMARD_OUTPUT_SOURCE).unwrap_or_default();
+    #[allow(unsafe_code)]
+    unsafe {
+        let kernel = mlx_sys::mlx_fast_metal_kernel_new(
+            c"higgs_eschamoe_scaled_hadamard_output".as_ptr(),
+            in_vec,
+            out_vec,
+            source.as_ptr(),
+            c"".as_ptr(),
+            true,
+            false,
+        );
+        mlx_sys::mlx_vector_string_free(in_vec);
+        mlx_sys::mlx_vector_string_free(out_vec);
+        kernel
+    }
+}
+
+static ESCHA_SCALED_HADAMARD_OUTPUT_KERNEL: OnceLock<CachedMetalKernel> = OnceLock::new();
+
+/// Apply the orthonormal 128-wide output Hadamard and selected expert scales.
+///
+/// `mid` is `[rows, width]` f32, `scales` is `[experts, width]` f32, and
+/// `expert_ids` is `[rows]` u32. The output keeps the current f32 contract.
+#[allow(unsafe_code)]
+pub(crate) fn eschamoe_scaled_hadamard_output(
+    mid: &Array,
+    scales: &Array,
+    expert_ids: &Array,
+) -> Result<Array, Exception> {
+    let &[rows, width] = mid.shape() else {
+        return Err(Exception::custom(format!(
+            "eschamoe_scaled_hadamard_output: mid shape {:?} is not [rows, width]",
+            mid.shape()
+        )));
+    };
+    let &[experts, scale_width] = scales.shape() else {
+        return Err(Exception::custom(format!(
+            "eschamoe_scaled_hadamard_output: scales shape {:?} is not [experts, width]",
+            scales.shape()
+        )));
+    };
+    if mid.dtype() != Dtype::Float32 || scales.dtype() != Dtype::Float32 {
+        return Err(Exception::custom(
+            "eschamoe_scaled_hadamard_output: mid and scales must be float32",
+        ));
+    }
+    if expert_ids.dtype() != Dtype::Uint32 || expert_ids.shape() != [rows] {
+        return Err(Exception::custom(format!(
+            "eschamoe_scaled_hadamard_output: expert ids {:?} {:?} do not match [{rows}] uint32",
+            expert_ids.dtype(),
+            expert_ids.shape()
+        )));
+    }
+    if experts <= 0 || width <= 0 || width != scale_width || width % 128 != 0 {
+        return Err(Exception::custom(format!(
+            "eschamoe_scaled_hadamard_output: mid/scales shapes {:?}/{:?} require matching positive widths divisible by 128 and at least one expert",
+            mid.shape(),
+            scales.shape()
+        )));
+    }
+    if rows == 0 {
+        return mlx_rs::ops::zeros_dtype(&[0, width], Dtype::Float32);
+    }
+
+    ensure_ffi_error_handler();
+    let stream = Stream::task_local_or_default();
+    let cached = ESCHA_SCALED_HADAMARD_OUTPUT_KERNEL
+        .get_or_init(|| CachedMetalKernel(create_escha_scaled_hadamard_output_kernel()));
+    let out_shape = [rows, width];
+
+    unsafe {
+        let config = mlx_sys::mlx_fast_metal_kernel_config_new();
+        let config_status = mlx_sys::mlx_fast_metal_kernel_config_add_template_arg_int(
+            config,
+            c"E".as_ptr(),
+            experts,
+        ) | mlx_sys::mlx_fast_metal_kernel_config_add_template_arg_int(
+            config,
+            c"OUT".as_ptr(),
+            width,
+        ) | mlx_sys::mlx_fast_metal_kernel_config_set_grid(
+            config,
+            128,
+            width / 128,
+            rows,
+        ) | mlx_sys::mlx_fast_metal_kernel_config_set_thread_group(config, 128, 1, 1)
+            | mlx_sys::mlx_fast_metal_kernel_config_add_output_arg(
+                config,
+                out_shape.as_ptr(),
+                out_shape.len(),
+                mlx_sys::mlx_dtype__MLX_FLOAT32,
+            );
+        if config_status != 0 {
+            mlx_sys::mlx_fast_metal_kernel_config_free(config);
+            return Err(Exception::custom(format!(
+                "configure eschamoe_scaled_hadamard_output failed: {}",
+                take_last_error()
+            )));
+        }
+
+        let input_ptrs = [mid.as_ptr(), scales.as_ptr(), expert_ids.as_ptr()];
+        let inputs_vec = mlx_sys::mlx_vector_array_new_data(input_ptrs.as_ptr(), input_ptrs.len());
+        let mut outputs_vec = mlx_sys::mlx_vector_array_new();
+        let status = mlx_sys::mlx_fast_metal_kernel_apply(
+            &raw mut outputs_vec,
+            cached.0,
+            inputs_vec,
+            config,
+            stream.as_ptr(),
+        );
+
+        let result = if status == 0 {
+            let mut out_ptr = mlx_sys::mlx_array_new();
+            let get_status = mlx_sys::mlx_vector_array_get(&raw mut out_ptr, outputs_vec, 0);
+            if get_status == 0 {
+                Ok(Array::from_ptr(out_ptr))
+            } else {
+                mlx_sys::mlx_array_free(out_ptr);
+                Err(Exception::custom(format!(
+                    "eschamoe_scaled_hadamard_output: output read failed: {}",
+                    take_last_error()
+                )))
+            }
+        } else {
+            Err(Exception::custom(format!(
+                "eschamoe_scaled_hadamard_output failed: {}",
+                take_last_error()
+            )))
+        };
+
+        mlx_sys::mlx_fast_metal_kernel_config_free(config);
+        mlx_sys::mlx_vector_array_free(inputs_vec);
+        mlx_sys::mlx_vector_array_free(outputs_vec);
+        result
+    }
+}
