[?2004l[?2004h>             capture_output=True, text=True
[?2004l[?2004h>         )
[?2004l[?2004h>         subject = cn_result.stdout.strip()
[?2004l[?2004h>         cn = None
[?2004l[?2004h>         for part in subject.split(','):
[?2004l[?2004h>             part = part.strip()
[?2004l[?2004h>             if part.startswith('CN =') or part.startswith('CN='):
[?2004l[?2004h>                 cn = part.split('=')[1].strip() if '=' in part else part.split(':')[1].strip()
[?2004l[?2004h>                 break
