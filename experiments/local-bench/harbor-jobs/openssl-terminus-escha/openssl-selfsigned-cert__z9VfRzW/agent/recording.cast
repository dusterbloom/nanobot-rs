[62.656462, "i", "echo '=== Certificate Subject ===' > /app/ssl/verification.txt && openssl x509 -in /app/ssl/server.crt -noout -subject >> /app/ssl/verification.txt && echo '' >> /app/ssl/verification.txt && echo '=== Validity Dates ===' >> /app/ssl/verification.txt && openssl x509 -in /app/ssl/server.crt -noout -dates >> /app/ssl/verification.txt && echo '' >> /app/ssl/verification.txt && echo '=== SHA-256 Fingerprint ===' >> /app/ssl/verification.txt && openssl x509 -in /app/ssl/server.crt -noout -fingerprint -sha256 >> /app/ssl/verification.txt\n"]
[62.65709, "o", "echo '=== Certificate Subject ===' > /app/ssl/verification.txt && openssl x509 -in /app/ssl/server.crt -noout -subject >> /app/ssl/verification.txt && echo '' >> /app/ssl/verification.txt && echo '=== Validity Dates ===' >> /app/ssl/verification.txt && openssl x509 -in /app/ssl/server.crt -noout -dates >> /app/ssl/verification.txt && echo '' >> /app/ssl/verification.txt && echo '=== SHA-256 Fingerprint ===' >> /app/ssl/verification.txt && openssl x509 -in /app/ssl/server.crt -noout -fingerprint -sha256 >> /app/ssl/verification.txt\r\n\u001b[?2004l\r"]
[62.703314, "o", "\u001b[?2004hroot@46e2f50c66be:/app# "]
[63.68836, "i", "cat /app/ssl/verification.txt\n"]
[63.688594, "o", "cat /app/ssl/verification.txt\r\n\u001b[?2004l\r"]
[63.688874, "o", "=== Certificate Subject ===\r\nsubject=O = DevOps Team, CN = dev-internal.company.local\r\n\r\n=== Validity Dates ===\r\nnotBefore=Sep  6 00:38:00 2026 GMT\r\nnotAfter=Sep  6 00:38:00 2027 GMT\r\n\r\n=== SHA-256 Fingerprint ===\r\nsha256 Fingerprint=55:DF:47:E5:B2:4D:41:C3:70:D7:AF:72:C6:36:15:50:05:2A:D0:A6:8F:EB:80:BF:E3:2B:59:02:E7:1A:F3:82\r\n"]
[63.68903, "o", "\u001b[?2004hroot@46e2f50c66be:/app# "]
[63.829585, "i", "cat > /app/check_cert.py << 'EOF'\nimport subprocess\nimport sys\nfrom datetime import datetime\n\ndef check_certificate(cert_path):\n    try:\n        # Check if certificate exists\n        import os\n        if not os.path.exists(cert_path):\n            print(f\"Error: Certificate file not found at {cert_path}\")\n            return False\n\n        # Load and verify certificate using openssl\n        result = subprocess.run(\n            ['openssl', 'x509', '-in', cert_path, '-noout', '-text'],\n            capture_output=True, text=True\n        )\n        if result.returncode != 0:\n            print(f\"Error loading certificate: {result.stderr}\")\n            return False\n\n        output = result.stdout\n\n        # Extract Common Name\n        cn_result = subprocess.run(\n            ['openssl', 'x509', '-in', cert_path, '-noout', '-subject'],\n            capture_output=True, text=True\n        )\n        subject = cn_result.stdout.strip()\n        cn = None\n        for part in subject.split(','):\n            part = part.strip()\n "]
[63.829662, "i", "           if part.startswith('CN =') or part.startswith('CN='):\n                cn = part.split('=')[1].strip() if '=' in part else part.split(':')[1].strip()\n                break\n\n        # Extract validity dates\n        dates_result = subprocess.run(\n            ['openssl', 'x509', '-in', cert_path, '-noout', '-enddate'],\n            capture_output=True, text=True\n        )\n        end_date_str = dates_result.stdout.strip().split('=')[1].strip()\n        # Parse OpenSSL date format like \"May  5 12:00:00 2026 GMT\"\n        exp_date = datetime.strptime(end_date_str, \"%b %d %H:%M:%S %Y %Z\")\n        expiration_formatted = exp_date.strftime(\"%Y-%m-%d\")\n\n        print(f\"Certificate loaded successfully.\")\n        print(f\"Common Name (CN): {cn}\")\n        print(f\"Expiration Date: {expiration_formatted}\")\n        print(f\"Subject: {subject}\")\n        print(\"Certificate verification successful\")\n        return True\n\n    except Exception as e:\n        print(f\"Error during certificate verification: {e}\")\n        return F"]
[63.829761, "o", "cat > /app/check_cert.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.829768, "i", "alse\n\nif __name__ == '__main__':\n    cert_file = '/app/ssl/server.crt'\n    success = check_certificate(cert_file)\n    sys.exit(0 if success else 1)\nEOF\n"]
