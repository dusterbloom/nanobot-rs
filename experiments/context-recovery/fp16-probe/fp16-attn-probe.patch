+static FP16_ATTN_PROBE_ENABLED: OnceLock<bool> = OnceLock::new();
+
+fn fp16_attn_probe_enabled() -> bool {
+    *FP16_ATTN_PROBE_ENABLED
+        .get_or_init(|| std::env::var("HIGGS_FP16_ATTN_PROBE").is_ok_and(|value| value == "1"))
+}
+
+/// Diagnostic-only FP16 attention boundary for the native Qwen3Next path.
+///
+/// The cache probe supplies FP16 K/V. Casting Q before SDPA prevents MLX's
+/// common-dtype rule from promoting the full K/V view back to FP32; the small
+/// attention result is restored to the surrounding activation dtype before
+/// gated output projection. This leaves model weights and GDN state untouched.
+fn qwen3_next_dense_sdpa<'a>(
+    queries: Array,
+    keys: Array,
+    values: Array,
+    scale: f32,
+    mask: Option<fast::ScaledDotProductAttentionMask<'a>>,
+) -> Result<Array, Exception> {
+    if !fp16_attn_probe_enabled() {
+        return fast::scaled_dot_product_attention(
+            queries,
+            keys,
+            values,
+            scale,
+            mask,
+            None::<&Array>,
+        );
+    }
+    if keys.dtype() != Dtype::Float16 || values.dtype() != Dtype::Float16 {
+        return Err(Exception::custom(
+            "HIGGS_FP16_ATTN_PROBE requires FP16 dense K/V storage",
+        ));
+    }
+
+    let activation_dtype = queries.dtype();
+    let queries = queries.as_dtype(Dtype::Float16)?;
+    let output =
+        fast::scaled_dot_product_attention(queries, keys, values, scale, mask, None::<&Array>)?;
+    if output.dtype() != Dtype::Float16 {
+        return Err(Exception::custom(format!(
+            "FP16 attention probe expected FP16 SDPA output, got {:?}",
+            output.dtype()
+        )));
+    }
+    output.as_dtype(activation_dtype)
+}
