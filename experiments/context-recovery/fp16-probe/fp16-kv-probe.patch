+    #[test]
+    fn fp16_probe_stores_and_returns_fp16() {
+        assert!(
+            fp16_kv_probe_enabled(),
+            "run this diagnostic with HIGGS_FP16_KV_PROBE=1"
+        );
+        let _exec = crate::mlx_exec::acquire();
+        let mut cache = SteppingKeyValueCache::new();
+        let values = (0..3 * 4)
+            .map(|index| (index as f32 * 0.031_25).sin())
+            .collect::<Vec<_>>();
+        let appended = Array::from_slice(&values, &[1, 1, 3, 4]);
+
+        let view = cache
+            .update_and_view(appended.clone(), appended.clone())
+            .unwrap();
+        let (view_keys, view_values) = view.into_dense().unwrap();
+        assert_eq!(cache.keys().unwrap().dtype(), Dtype::Float16);
+        assert_eq!(cache.values().unwrap().dtype(), Dtype::Float16);
+        assert_eq!(view_keys.dtype(), Dtype::Float16);
+        assert_eq!(view_values.dtype(), Dtype::Float16);
+        assert_eq!(cache.estimated_bytes(), 2 * 256 * 4 * 2);
+
+        let continued = Array::from_slice(&[0.5_f32, -0.5, 0.25, -0.25], &[1, 1, 1, 4]);
+        let view = cache
+            .update_and_view(continued.clone(), continued.clone())
+            .unwrap();
+        let (view_keys, view_values) = view.into_dense().unwrap();
+        mlx_rs::transforms::eval([&view_keys, &view_values]).unwrap();
+        assert_eq!(cache.offset(), 4);
+        assert_eq!(view_keys.shape(), &[1, 1, 4, 4]);
+        assert_eq!(view_values.shape(), &[1, 1, 4, 4]);
+        assert_eq!(view_keys.dtype(), Dtype::Float16);
+        assert_eq!(view_values.dtype(), Dtype::Float16);
+        let expected = appended
+            .as_dtype(Dtype::Float16)
+            .unwrap()
+            .as_dtype(Dtype::Float32)
+            .unwrap();
+        let stored_prefix = slice_axis2(&view_keys, 0, 3)
+            .unwrap()
+            .as_dtype(Dtype::Float32)
+            .unwrap();
+        mlx_rs::transforms::eval([&expected, &stored_prefix]).unwrap();
+        assert_eq!(stored_prefix.as_slice::<f32>(), expected.as_slice::<f32>());
+    }
