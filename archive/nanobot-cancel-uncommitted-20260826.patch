+struct CompactionTaskDrop(Arc<std::sync::atomic::AtomicBool>);
+
+impl Drop for CompactionTaskDrop {
+    fn drop(&mut self) {
+        self.0.store(true, std::sync::atomic::Ordering::Release);
+    }
+}
