+fn resolve_llama_server_command() -> Result<PathBuf, String> {
+    if let Ok(path) = env::var("NANOBOT_LLAMA_SERVER") {
+        let trimmed = path.trim();
+        if !trimmed.is_empty() {
+            let candidate = PathBuf::from(trimmed);
+            if candidate.exists() {
+                return Ok(candidate);
+            }
+            return Err(format!(
+                "llama-server not found at NANOBOT_LLAMA_SERVER path {}",
+                candidate.display()
+            ));
+        }
+    }
+
+    let mut searched: Vec<PathBuf> = Vec::new();
+    if let Some(home) = dirs::home_dir() {
+        let candidates = [
+            home.join("llama.cpp/build/bin/llama-server"),
+            home.join(".nanobot/bin/llama-server"),
+            home.join(".local/bin/llama-server"),
+        ];
+        for candidate in candidates {
+            if candidate.exists() {
+                return Ok(candidate);
+            }
+            searched.push(candidate);
+        }
+    }
+
+    if command_exists_in_path("llama-server") {
+        return Ok(PathBuf::from("llama-server"));
+    }
+
+    let mut msg = String::from("llama-server not found. Set NANOBOT_LLAMA_SERVER or install it in PATH");
+    if !searched.is_empty() {
+        let locations = searched
+            .iter()
+            .map(|p| p.display().to_string())
+            .collect::<Vec<_>>()
+            .join(", ");
+        msg.push_str(&format!(" (searched: {})", locations));
+    }
+    Err(msg)
+}
