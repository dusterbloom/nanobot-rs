+        || lower.contains(".json")
+}
+
+/// Heuristic filter for low-value assistant replies that can poison local
+/// conversational history (identity loops or malformed numeric noise).
+fn is_low_value_assistant_history(content: &str) -> bool {
+    let text = content.trim();
+    if text.is_empty() {
+        return true;
+    }
+
+    let lower = text.to_lowercase();
+    const SELF_INTRO_PATTERNS: &[&str] = &[
+        "i'm nanobot",
+        "i am nanobot",
+        "your ai assistant",
+        "your local ai assistant",
+        "how can i help you today",
+        "what's on your mind today",
+        "what can i assist you with today",
+        "i'm ready to help",
+        "i'm here to help",
+        "want to chat",
+    ];
+    if SELF_INTRO_PATTERNS
+        .iter()
+        .any(|pattern| lower.contains(pattern))
+        && text.chars().count() <= 320
+    {
+        return true;
+    }
+
+    let mut alpha = 0usize;
+    let mut digits = 0usize;
+    let mut punctuation = 0usize;
+    let mut total = 0usize;
+    for ch in text.chars() {
+        total += 1;
+        if ch.is_alphabetic() {
+            alpha += 1;
+        } else if ch.is_ascii_digit() {
+            digits += 1;
+        } else if ch.is_ascii_punctuation() {
+            punctuation += 1;
+        }
+    }
+
+    if total < 160 {
+        return false;
+    }
+    let alpha_ratio = alpha as f64 / total as f64;
+    let noisy_ratio = (digits + punctuation) as f64 / total as f64;
+    alpha_ratio < 0.22 && noisy_ratio > 0.60
+}
+
+/// For plain conversational CLI turns, trim poisoned assistant turns and keep a
+/// short recent window to reduce style-lock and latency.
+fn prepare_history_for_conversational_cli(mut history: Vec<Value>) -> Vec<Value> {
+    history.retain(|msg| {
+        let role = msg
+            .get("role")
+            .and_then(|v| v.as_str())
+            .unwrap_or_default();
+        if role == "assistant" {
+            return false;
+        }
+        if role == "tool" {
+            let content = msg
+                .get("content")
+                .and_then(|v| v.as_str())
+                .unwrap_or_default();
+            return !is_low_value_assistant_history(content);
+        }
+        if role != "user" {
+            return true;
+        }
+        true
+    });
+
+    const MAX_RECENT_MESSAGES: usize = 8;
+    if history.len() > MAX_RECENT_MESSAGES {
+        history = history[history.len() - MAX_RECENT_MESSAGES..].to_vec();
+    }
+    history
+}
