+        "i'm unable",
+        "i am unable",
+        "i apologize",
+        "i'm sorry",
+        "as an ai",
+        "as a language model",
+        "unable to help",
+        "cannot assist",
+        "can't assist",
+        "cannot fulfill",
+        "can't fulfill",
+        "not able to provide",
+        "unable to provide",
+        "i won't",
+        "i will not",
+        "against my guidelines",
+        "violates my",
+        "i'm not comfortable",
+        "i am not comfortable",
+        "ethically",
+        "unethical",
+        "harmful",
+    ];
+    
+    for indicator in &refusal_indicators {
+        if lower.contains(indicator) {
+            return true;
+        }
+    }
