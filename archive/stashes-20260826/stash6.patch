+/// Run an async future from sync code without dropping a Tokio runtime inside
+/// an async context.
+pub(crate) fn block_on_with_runtime_guard<F, T>(future: F) -> T
+where
+    F: Future<Output = T> + Send,
+    T: Send,
+{
+    match tokio::runtime::Handle::try_current() {
+        Ok(handle) => match handle.runtime_flavor() {
+            tokio::runtime::RuntimeFlavor::MultiThread => {
+                tokio::task::block_in_place(|| handle.block_on(future))
+            }
+            tokio::runtime::RuntimeFlavor::CurrentThread => std::thread::scope(|scope| {
+                scope
+                    .spawn(move || {
+                        let rt = tokio::runtime::Builder::new_current_thread()
+                            .enable_all()
+                            .build()
+                            .expect("Failed to create tokio runtime");
+                        rt.block_on(future)
+                    })
+                    .join()
+                    .expect("Runtime guard thread panicked")
+            }),
+            _ => std::thread::scope(|scope| {
+                scope
+                    .spawn(move || {
+                        let rt = tokio::runtime::Builder::new_current_thread()
+                            .enable_all()
+                            .build()
+                            .expect("Failed to create tokio runtime");
+                        rt.block_on(future)
+                    })
+                    .join()
+                    .expect("Runtime guard thread panicked")
+            }),
+        },
+        Err(_) => {
+            let runtime = tokio::runtime::Runtime::new().expect("Failed to create tokio runtime");
+            runtime.block_on(future)
+        }
+    }
+}
