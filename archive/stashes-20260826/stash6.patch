+/// True when a model is currently quarantined as incompatible for a backend.
+pub(crate) fn is_model_quarantined(
+    model_path: &Path,
+    backend_label: &str,
+    quarantine_hours: u32,
+) -> bool {
+    let _ = quarantine_hours; // backend-specific expiration is stored per entry.
+    let mut cache = load_local_model_health();
+    let changed = prune_expired_health_entries(&mut cache);
+    if changed {
+        save_local_model_health(&cache);
+    }
+    let key = normalize_model_key(model_path);
+    let backend = backend_label.to_ascii_lowercase();
+    cache.entries.iter().any(|e| {
+        e.status == "incompatible"
+            && e.model_path == key
+            && e.backend == backend
+            && e.expires_at_epoch_secs > unix_now_secs()
+    })
+}
+
+/// Mark a model/backend pair as incompatible for a time window.
+pub(crate) fn mark_model_incompatible(
+    model_path: &Path,
+    backend_label: &str,
+    reason: &str,
+    quarantine_hours: u32,
+) {
+    let mut cache = load_local_model_health();
+    let _ = prune_expired_health_entries(&mut cache);
+    let now = unix_now_secs();
+    let expires = now.saturating_add((quarantine_hours.max(1) as u64) * 3600);
+    let key = normalize_model_key(model_path);
+    let backend = backend_label.to_ascii_lowercase();
+    cache.entries.retain(|e| !(e.model_path == key && e.backend == backend));
+    cache.entries.push(LocalModelHealthEntry {
+        model_path: key,
+        backend,
+        status: "incompatible".to_string(),
+        reason: reason.to_string(),
+        recorded_at_epoch_secs: now,
+        expires_at_epoch_secs: expires,
+    });
+    save_local_model_health(&cache);
+}
