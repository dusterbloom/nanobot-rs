+pub(crate) fn local_runtime_probe() -> LocalRuntimeProbe {
+    let platform = detect_host_platform();
+
+    let llama = match probe_env_executable(LLAMA_SERVER_ENV) {
+        Ok(Some(path)) => RuntimeToolStatus {
+            ready: true,
