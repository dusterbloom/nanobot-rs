+/// Classify an MLX model for text chat safety.
+///
+/// Chat-safe:
+/// - contains `ForCausalLM`
+/// - and does not contain known multimodal/OCR markers.
+///
+/// Advanced:
+/// - OCR/VL/ConditionalGeneration
+/// - unknown/empty architecture metadata.
+pub(crate) fn classify_mlx_model(path: &Path) -> MlxModelClass {
+    let Some(model_dir) = normalize_mlx_model_path(path) else {
+        return MlxModelClass::Advanced;
+    };
+    let archs = parse_mlx_architectures(&model_dir);
+    if archs.is_empty() {
+        return MlxModelClass::Advanced;
+    }
+    let has_chat_safe = archs.iter().any(|arch| {
+        let lower = arch.to_ascii_lowercase();
+        lower.contains("forcausallm") && !architecture_is_advanced(arch)
+    });
+    if has_chat_safe {
+        MlxModelClass::ChatSafe
+    } else {
+        MlxModelClass::Advanced
+    }
+}
+
+fn collect_mlx_model_dirs_recursive(root: &Path, max_dirs: usize) -> Vec<PathBuf> {
+    let mut out = Vec::new();
+    if !root.is_dir() {
+        return out;
+    }
+    let mut stack = vec![root.to_path_buf()];
+    while let Some(dir) = stack.pop() {
+        if is_mlx_model_dir(&dir) {
+            out.push(dir);
+            if out.len() >= max_dirs {
+                return out;
+            }
+            // Don't descend into model dir children to avoid duplicate picks.
+            continue;
+        }
+        let entries = match std::fs::read_dir(&dir) {
+            Ok(e) => e,
+            Err(_) => continue,
+        };
+        for entry in entries.filter_map(Result::ok) {
+            let file_type = match entry.file_type() {
+                Ok(t) => t,
+                Err(_) => continue,
+            };
+            if file_type.is_dir() {
+                // Avoid descending into symlinked directories to prevent cycles.
+                if file_type.is_symlink() {
+                    continue;
+                }
+                stack.push(entry.path());
+            }
+        }
+    }
+    out
+}
