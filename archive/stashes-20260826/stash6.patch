+
+fn collect_gguf_recursive(root: &Path, max_files: usize) -> Vec<PathBuf> {
+    let mut out = Vec::new();
+    if !root.is_dir() {
+        return out;
+    }
+    let mut stack = vec![root.to_path_buf()];
+    while let Some(dir) = stack.pop() {
+        let entries = match std::fs::read_dir(&dir) {
+            Ok(e) => e,
+            Err(_) => continue,
+        };
+        for entry in entries.filter_map(Result::ok) {
+            let path = entry.path();
+            let file_type = match entry.file_type() {
+                Ok(t) => t,
+                Err(_) => continue,
+            };
+            if file_type.is_dir() {
+                // Avoid descending into symlinked directories to prevent cycles.
+                if file_type.is_symlink() {
+                    continue;
+                }
+                stack.push(path);
+                continue;
+            }
+            if is_supported_gguf_model(&path) {
+                out.push(path);
+                if out.len() >= max_files {
+                    return out;
+                }
+            }
+        }
+    }
+    out
+}
+
+fn dedupe_models_by_canonical(paths: Vec<PathBuf>) -> Vec<PathBuf> {
+    let mut seen = std::collections::HashSet::<String>::new();
+    let mut out = Vec::new();
+    for path in paths {
+        let key = std::fs::canonicalize(&path)
+            .unwrap_or_else(|_| path.clone())
+            .to_string_lossy()
+            .to_string();
+        if seen.insert(key) {
+            out.push(path);
+        }
+    }
+    out
+}
