+/// Normalize a user-selected MLX path to a model directory.
+///
+/// Accepts either:
+/// - a model directory (`config.json` + one or more `.safetensors` / `.mlx`)
+/// - a model weight file inside such a directory.
+pub(crate) fn normalize_mlx_model_path(path: &Path) -> Option<PathBuf> {
+    if is_mlx_model_dir(path) {
+        return Some(path.to_path_buf());
+    }
+    if is_mlx_weight_file(path) {
+        let parent = path.parent()?;
+        if is_mlx_model_dir(parent) {
+            return Some(parent.to_path_buf());
+        }
+    }
+    None
+}
