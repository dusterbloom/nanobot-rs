+        .collect()
+}
+
+fn parse_arguments_value(arguments_raw: &serde_json::Value) -> HashMap<String, serde_json::Value> {
+    if let Some(s) = arguments_raw.as_str() {
+        match serde_json::from_str::<serde_json::Value>(s) {
+            Ok(serde_json::Value::Object(map)) => map.into_iter().collect(),
+            _ => {
+                let mut m = HashMap::new();
+                m.insert("raw".to_string(), serde_json::Value::String(s.to_string()));
+                m
+            }
+        }
+    } else if let Some(obj) = arguments_raw.as_object() {
+        obj.iter().map(|(k, v)| (k.clone(), v.clone())).collect()
+    } else {
+        HashMap::new()
+    }
+}
+
+fn strip_xmlish_tags(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    let mut in_tag = false;
+    for ch in text.chars() {
+        match ch {
+            '<' => in_tag = true,
+            '>' => in_tag = false,
+            _ if !in_tag => out.push(ch),
+            _ => {}
+        }
+    }
+    out
+}
+
+fn parse_inline_tool_args_from_name(raw_name: &str) -> Option<HashMap<String, serde_json::Value>> {
+    let open = raw_name.find('(')?;
+    let tail = &raw_name[open + 1..];
+    let close_rel = tail.rfind(')')?;
+    let args_str = tail[..close_rel].trim();
+    if args_str.is_empty() {
+        return None;
+    }
+    match serde_json::from_str::<serde_json::Value>(args_str) {
+        Ok(serde_json::Value::Object(map)) => Some(map.into_iter().collect()),
+        _ => None,
+    }
+}
+
+fn merge_if_missing(
+    mut base: HashMap<String, serde_json::Value>,
+    extra: Option<HashMap<String, serde_json::Value>>,
+) -> HashMap<String, serde_json::Value> {
+    if let Some(extra_map) = extra {
+        for (k, v) in extra_map {
+            base.entry(k).or_insert(v);
+        }
+    }
+    base
+}
+
+fn normalize_tool_name(
+    raw_name: &str,
+    allowed_tool_names: &[String],
+) -> Option<(String, Option<HashMap<String, serde_json::Value>>)> {
+    let trimmed = raw_name.trim();
+    if trimmed.is_empty() {
+        return None;
+    }
+    let inline_args = parse_inline_tool_args_from_name(trimmed);
+
+    let base_before_paren = trimmed
+        .split_once('(')
+        .map(|(head, _)| head.trim())
+        .unwrap_or(trimmed);
+    let stripped = strip_xmlish_tags(trimmed);
+    let stripped_before_paren = stripped
+        .split_once('(')
+        .map(|(head, _)| head.trim())
+        .unwrap_or_else(|| stripped.trim());
+
+    let mut candidates: Vec<String> = vec![
+        trimmed.to_string(),
+        base_before_paren.to_string(),
+        stripped.trim().to_string(),
+        stripped_before_paren.to_string(),
+    ];
+    if let Some(token) = stripped_before_paren
+        .chars()
+        .map(|c| {
+            if c.is_ascii_alphanumeric() || c == '_' {
+                c
+            } else {
+                ' '
+            }
+        })
+        .collect::<String>()
+        .split_whitespace()
+        .next()
+    {
+        candidates.push(token.to_string());
+    }
+    candidates.retain(|c| !c.is_empty());
+    candidates.dedup();
+
+    if allowed_tool_names.is_empty() {
+        return candidates
+            .first()
+            .cloned()
+            .map(|name| (name, inline_args));
+    }
+
+    for candidate in candidates {
+        if allowed_tool_names.iter().any(|n| n == &candidate) {
+            return Some((candidate, inline_args));
+        }
+    }
+
+    None
+}
+
+fn parse_embedded_tool_calls(
+    content: &str,
+    allowed_tool_names: &[String],
+) -> Vec<ToolCallRequest> {
+    // If no tools are explicitly allowed for this call, never recover tool
+    // calls from free-form text (prevents accidental JSON over-interpretation).
+    if allowed_tool_names.is_empty() {
+        return Vec::new();
+    }
+
+    let normalized = content.trim();
+    if normalized.is_empty() {
+        return Vec::new();
+    }
+
+    let lower = normalized.to_ascii_lowercase();
+    let has_tool_tag = lower.contains("<tool_call");
+    let starts_as_payload = normalized.starts_with('{')
+        || normalized.starts_with('[')
+        || normalized.starts_with("```");
+    let heading_payload = if normalized.starts_with('#') {
+        let trimmed = normalized.trim_start_matches('#').trim_start();
+        if trimmed.starts_with('{') && trimmed.ends_with('}') {
+            Some(trimmed.to_string())
+        } else {
+            None
+        }
+    } else {
+        None
+    };
+    if !has_tool_tag && !starts_as_payload {
+        if heading_payload.is_none() {
+            return Vec::new();
+        }
+    }
+
+    let mut candidates = Vec::new();
+    if starts_as_payload {
+        candidates.push(normalized.to_string());
+    }
+    if normalized.starts_with("```") {
+        if let Some(first_nl) = normalized.find('\n') {
+            let tail = &normalized[first_nl + 1..];
+            if let Some(end_fence) = tail.rfind("```") {
+                candidates.push(tail[..end_fence].trim().to_string());
+            }
+        }
+    }
+    if has_tool_tag {
+        if let (Some(start), Some(end)) = (normalized.find('{'), normalized.rfind('}')) {
+            if end > start {
+                candidates.push(normalized[start..=end].to_string());
+            }
+        }
+    }
+    if has_tool_tag {
+        if let (Some(start), Some(end)) = (normalized.find('['), normalized.rfind(']')) {
+            if end > start {
+                candidates.push(normalized[start..=end].to_string());
+            }
+        }
+    }
+    if let Some(h) = heading_payload {
+        candidates.push(h);
+    }
+    candidates.retain(|c| !c.is_empty());
+    candidates.dedup();
+
+    if candidates.is_empty() {
+        return Vec::new();
+    }
+
+    let mut parsed_value = None;
+    for candidate in candidates {
+        if let Ok(v) = serde_json::from_str::<serde_json::Value>(&candidate) {
+            parsed_value = Some(v);
+            break;
+        }
+    }
+    let Some(value) = parsed_value else {
+        return Vec::new();
+    };
+
+    let is_allowed = |name: &str| {
+        allowed_tool_names.is_empty() || allowed_tool_names.iter().any(|n| n == name)
+    };
+    let mut out: Vec<ToolCallRequest> = Vec::new();
+
+    let mut push_call = |name: &str, args: serde_json::Value| {
+        if !name.is_empty() && is_allowed(name) {
+            out.push(ToolCallRequest {
+                id: format!("content_call_{}", out.len()),
+                name: name.to_string(),
+                arguments: parse_arguments_value(&args),
+            });
+        }
+    };
+
+    let parse_single = |obj: &serde_json::Map<String, serde_json::Value>,
+                        push_call: &mut dyn FnMut(&str, serde_json::Value)| {
+        if let Some(tc_array) = obj.get("tool_calls").and_then(|v| v.as_array()) {
+            for tc in tc_array {
+                if let Some(function) = tc.get("function").and_then(|v| v.as_object()) {
+                    let name = function
+                        .get("name")
+                        .and_then(|v| v.as_str())
+                        .unwrap_or("");
+                    let args = function
+                        .get("arguments")
+                        .cloned()
+                        .unwrap_or_else(|| serde_json::json!({}));
+                    push_call(name, args);
+                }
+            }
+            return;
+        }
+
+        if let Some(name) = obj.get("function").and_then(|v| v.as_str()) {
+            let args = obj
+                .get("parameters")
+                .cloned()
+                .or_else(|| obj.get("arguments").cloned())
+                .unwrap_or_else(|| serde_json::json!({}));
+            push_call(name, args);
+            return;
+        }
+
+        if let Some(name) = obj.get("name").and_then(|v| v.as_str()) {
+            let args = obj
+                .get("arguments")
+                .cloned()
+                .or_else(|| obj.get("parameters").cloned())
+                .or_else(|| obj.get("args").cloned())
+                .unwrap_or_else(|| serde_json::json!({}));
+            push_call(name, args);
+            return;
+        }
+
+        if let Some(function) = obj.get("function").and_then(|v| v.as_object()) {
+            let name = function.get("name").and_then(|v| v.as_str()).unwrap_or("");
+            let args = function
+                .get("arguments")
+                .cloned()
+                .or_else(|| obj.get("parameters").cloned())
+                .or_else(|| obj.get("arguments").cloned())
+                .unwrap_or_else(|| serde_json::json!({}));
+            push_call(name, args);
+            return;
+        }
+
+        if let Some(tool) = obj.get("tool").and_then(|v| v.as_object()) {
+            let name = tool.get("name").and_then(|v| v.as_str()).unwrap_or("");
+            let args = tool
+                .get("arguments")
+                .cloned()
+                .or_else(|| tool.get("parameters").cloned())
+                .unwrap_or_else(|| serde_json::json!({}));
+            push_call(name, args);
+        }
+    };
+
+    match value {
+        serde_json::Value::Array(items) => {
+            for item in items {
+                if let serde_json::Value::Object(obj) = item {
+                    parse_single(&obj, &mut push_call);
+                }
+            }
+        }
+        serde_json::Value::Object(obj) => {
+            parse_single(&obj, &mut push_call);
+        }
+        _ => {}
+    }
+
+    out
+}
