+fn strip_tagged_block(text: &str, open_tag: &str, close_tag: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    let mut remaining = text;
+    while let Some(start) = remaining.find(open_tag) {
+        out.push_str(&remaining[..start]);
+        if let Some(end_rel) = remaining[start + open_tag.len()..].find(close_tag) {
+            let after = start + open_tag.len() + end_rel + close_tag.len();
+            remaining = &remaining[after..];
+        } else {
+            // Unclosed internal-thought block: drop everything after the open tag.
+            return out;
+        }
+    }
+    out.push_str(remaining);
+    out
+}
+
+fn has_unclosed_tag(text: &str, open_tag: &str, close_tag: &str) -> bool {
+    let mut cursor = 0usize;
+    let mut depth = 0usize;
+    while cursor < text.len() {
+        let rest = &text[cursor..];
+        let next_open = rest.find(open_tag);
+        let next_close = rest.find(close_tag);
+        match (next_open, next_close) {
+            (Some(open_idx), Some(close_idx)) => {
+                if open_idx < close_idx {
+                    depth = depth.saturating_add(1);
+                    cursor += open_idx + open_tag.len();
+                } else {
+                    if depth > 0 {
+                        depth -= 1;
+                    }
+                    cursor += close_idx + close_tag.len();
+                }
+            }
+            (Some(open_idx), None) => {
+                depth = depth.saturating_add(1);
+                cursor += open_idx + open_tag.len();
+            }
+            (None, Some(close_idx)) => {
+                if depth > 0 {
+                    depth -= 1;
+                }
+                cursor += close_idx + close_tag.len();
+            }
+            (None, None) => break,
+        }
+    }
+    depth > 0
+}
+
+fn has_unclosed_think_block(text: &str) -> bool {
+    has_unclosed_tag(text, "<think>", "</think>")
+        || has_unclosed_tag(text, "<thinking>", "</thinking>")
+}
+
+fn first_protocol_marker_index(text: &str) -> Option<usize> {
+    ["<|channel|>", "<|message|>", "<|start|>", "<|end|>"]
+        .iter()
+        .filter_map(|marker| text.find(marker))
+        .min()
+}
+
+fn truncate_partial_protocol_suffix(text: &str) -> String {
+    let markers = ["<|channel|>", "<|message|>", "<|start|>", "<|end|>"];
+    let mut cut = text.len();
+    for marker in markers {
+        for i in 1..marker.len() {
+            let prefix = &marker[..i];
+            if text.ends_with(prefix) {
+                cut = cut.min(text.len().saturating_sub(prefix.len()));
+            }
+        }
+    }
+    text[..cut].to_string()
+}
+
+fn streaming_holdback_chars() -> usize {
+    const MARKERS: &[&str] = &[
+        "<think>",
+        "</think>",
+        "<thinking>",
+        "</thinking>",
+        "<|channel|>",
+        "<|message|>",
+        "<|start|>",
+        "<|end|>",
+    ];
+    MARKERS
+        .iter()
+        .map(|m| m.len())
+        .max()
+        .unwrap_or(0)
+}
+
+/// Remove internal reasoning/protocol artifacts from model output before display/persist.
+///
+/// This is intentionally strict:
+/// - strips `<think>...</think>` and `<thinking>...</thinking>`
+/// - drops everything from the first protocol frame marker (`<|channel|>` etc.)
+pub(crate) fn sanitize_assistant_output(text: &str) -> String {
+    let mut cleaned = text.to_string();
+    cleaned = strip_tagged_block(&cleaned, "<think>", "</think>");
+    cleaned = strip_tagged_block(&cleaned, "<thinking>", "</thinking>");
+    if let Some(idx) = first_protocol_marker_index(&cleaned) {
+        cleaned.truncate(idx);
+    }
+    cleaned = truncate_partial_protocol_suffix(&cleaned);
+    cleaned.trim().to_string()
+}
+
+#[derive(Default)]
+struct StreamingAssistantSanitizer {
+    raw: String,
+    emitted: String,
+}
+
+impl StreamingAssistantSanitizer {
+    fn push(&mut self, delta: &str) -> Option<String> {
+        self.raw.push_str(delta);
+        if has_unclosed_think_block(&self.raw) {
+            return None;
+        }
+        let holdback = streaming_holdback_chars();
+        let safe_len = crate::utils::helpers::floor_char_boundary(
+            &self.raw,
+            self.raw.len().saturating_sub(holdback),
+        );
+        let safe_prefix = &self.raw[..safe_len];
+        let sanitized = sanitize_assistant_output(safe_prefix);
+        if sanitized.starts_with(&self.emitted) {
+            let next = sanitized[self.emitted.len()..].to_string();
+            self.emitted = sanitized;
+            if next.is_empty() {
+                None
+            } else {
+                Some(next)
+            }
+        } else {
+            // Should be rare; keep stream safe and monotonic.
+            debug!("Sanitizer non-monotonic stream state; suppressing unsafe delta");
+            self.emitted = sanitized;
+            None
+        }
+    }
+
+    fn finish(&mut self) -> (Option<String>, Option<String>) {
+        let finalized = sanitize_assistant_output(&self.raw);
+        let extra_delta = if finalized.starts_with(&self.emitted) {
+            let tail = finalized[self.emitted.len()..].to_string();
+            if tail.is_empty() {
+                None
+            } else {
+                Some(tail)
+            }
+        } else {
+            debug!("Sanitizer finalization non-monotonic; suppressing tail delta");
+            None
+        };
+        self.emitted = finalized.clone();
+        let final_content = if finalized.is_empty() {
+            None
+        } else {
+            Some(finalized)
+        };
+        (extra_delta, final_content)
+    }
+}
