+fn architecture_is_advanced(arch: &str) -> bool {
+    let lower = arch.to_ascii_lowercase();
+    lower.contains("ocr")
+        || lower.contains("vl")
+        || lower.contains("vision")
+        || lower.contains("conditionalgeneration")
+}
