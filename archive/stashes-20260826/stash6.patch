+/// Return true if the path looks like an MLX model directory.
+///
+/// Heuristic: `config.json` exists and at least one MLX weight file
+/// (`.safetensors` / `.mlx`) exists in that directory.
+pub(crate) fn is_mlx_model_dir(path: &Path) -> bool {
+    if !path.is_dir() || !path.join("config.json").is_file() {
+        return false;
+    }
+    // Treat known scan roots as containers, never model dirs.
+    if is_mlx_scan_root(path) {
+        return false;
+    }
+    std::fs::read_dir(path)
+        .into_iter()
+        .flatten()
+        .filter_map(|e| e.ok())
+        .map(|e| e.path())
+        .any(|p| is_mlx_weight_file(&p))
+}
