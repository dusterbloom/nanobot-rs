+
+/// List all selectable local models for `/model`.
+///
+/// This merges GGUF files (llama.cpp path) and MLX model directories.
+pub(crate) fn list_selectable_local_models_with_policy(
+    policy: LocalModelListPolicy,
+) -> Vec<PathBuf> {
+    let mut models = list_available_gguf_models();
+    for m in list_available_mlx_models() {
+        if !policy.show_advanced_models && classify_mlx_model(&m) != MlxModelClass::ChatSafe {
+            continue;
+        }
+        if !policy.include_quarantined {
+            let backend = backend_label_for_model(&m);
+            if is_model_quarantined(&m, backend, policy.quarantine_hours) {
+                continue;
+            }
+        }
+        if !models.contains(&m) {
+            models.push(m);
+        }
+    }
+    if !policy.include_quarantined {
+        models.retain(|m| {
+            if normalize_mlx_model_path(m).is_none() {
+                return true;
+            }
+            let backend = backend_label_for_model(m);
+            !is_model_quarantined(m, backend, policy.quarantine_hours)
+        });
+    }
+    if prefer_mlx_model_selection() {
+        models.sort_by(|a, b| {
+            let a_bucket = if normalize_mlx_model_path(a).is_some() {
+                0usize
+            } else {
+                1usize
+            };
+            let b_bucket = if normalize_mlx_model_path(b).is_some() {
+                0usize
+            } else {
+                1usize
+            };
+            a_bucket
+                .cmp(&b_bucket)
+                .then_with(|| a.file_name().cmp(&b.file_name()))
+        });
+    } else {
+        models.sort_by(|a, b| a.file_name().cmp(&b.file_name()));
+    }
+    models
+}
+
+/// List all selectable local models for `/model` using current config policy.
+pub(crate) fn list_selectable_local_models() -> Vec<PathBuf> {
+    let cfg = crate::config::loader::load_config(None);
+    list_selectable_local_models_with_policy(LocalModelListPolicy::from_config(&cfg.local))
+}
