+/// List MLX model directories in `~/models/`.
+///
+/// Recursively scans `~/models/` for directories matching `is_mlx_model_dir`.
+pub(crate) fn list_local_mlx_models() -> Vec<PathBuf> {
+    let home = match dirs::home_dir() {
+        Some(h) => h,
+        None => return vec![],
+    };
+    let models_dir = home.join("models");
+    let mut out = collect_mlx_model_dirs_recursive(&models_dir, 2048);
+    out.sort_by(|a, b| a.file_name().cmp(&b.file_name()));
+    dedupe_models_by_canonical(out)
+}
+
+/// List MLX model directories in LM Studio cache directories.
+pub(crate) fn list_lmstudio_mlx_models() -> Vec<PathBuf> {
+    let mut out = Vec::new();
+    for root in list_lmstudio_roots() {
+        out.extend(collect_mlx_model_dirs_recursive(&root, 2048));
+    }
+    out.sort_by(|a, b| a.file_name().cmp(&b.file_name()));
+    dedupe_models_by_canonical(out)
+}
+
+/// List all MLX models available for local runtime, including LM Studio cache.
+pub(crate) fn list_available_mlx_models() -> Vec<PathBuf> {
+    let mut out = list_local_mlx_models();
+    out.extend(list_lmstudio_mlx_models());
+    out.sort_by(|a, b| a.file_name().cmp(&b.file_name()));
+    dedupe_models_by_canonical(out)
+}
