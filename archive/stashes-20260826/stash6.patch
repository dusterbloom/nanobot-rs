+/// Resolve the request model ID to send to local OpenAI-compatible servers.
+///
+/// Resolution order:
+/// 1) exact absolute-path ID match
+/// 2) repo-style ID tail matching selected model dir/file name
+/// 3) first ID returned by `/v1/models`
+pub(crate) async fn resolve_request_model_id(
+    api_base: &str,
+    selected_model_path: &Path,
+) -> Option<String> {
+    let root = normalize_api_root(api_base);
+    let models_url = format!("{}/v1/models", root);
+    let client = reqwest::Client::builder()
+        .timeout(std::time::Duration::from_secs(2))
+        .build()
+        .ok()?;
+    let normalized_selected = normalize_for_compare(selected_model_path);
+    let selected_abs = normalized_selected.to_string_lossy().to_string();
+    let selected_raw = selected_model_path.to_string_lossy().to_string();
+    for attempt in 0..8u8 {
+        if let Ok(response) = client.get(&models_url).send().await {
+            if response.status().is_success() {
+                if let Ok(payload) = response.json::<serde_json::Value>().await {
+                    let ids: Vec<String> = payload
+                        .get("data")
+                        .and_then(|v| v.as_array())
+                        .into_iter()
+                        .flatten()
+                        .filter_map(|m| m.get("id").and_then(|v| v.as_str()))
+                        .map(|s| s.to_string())
+                        .collect();
+                    if !ids.is_empty() {
+                        for id in &ids {
+                            let id_norm = normalize_for_compare(Path::new(id))
+                                .to_string_lossy()
+                                .to_string();
+                            if id == &selected_abs || id == &selected_raw || id_norm == selected_abs {
+                                return Some(id.clone());
+                            }
+                        }
+
+                        let tail = selected_model_path
+                            .file_name()
+                            .and_then(|n| n.to_str())
+                            .map(|s| s.to_ascii_lowercase())?;
+                        for id in &ids {
+                            let id_tail = id
+                                .rsplit('/')
+                                .next()
+                                .unwrap_or(id)
+                                .trim()
+                                .to_ascii_lowercase();
+                            if id_tail == tail {
+                                return Some(id.clone());
+                            }
+                        }
+
+                        return ids.into_iter().next();
+                    }
+                }
+            }
+        }
+        if attempt < 7 {
+            tokio::time::sleep(std::time::Duration::from_millis(250)).await;
+        }
+    }
+
+    fallback_request_model_id_from_path(selected_model_path)
+}
