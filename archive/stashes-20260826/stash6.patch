+        },
+        Err(e) => RuntimeToolStatus {
+            ready: false,
+            detail: e,
+        },
+        Ok(None) => {
+            if let Some(path) = discover_llama_server_no_bootstrap() {
+                RuntimeToolStatus {
+                    ready: true,
+                    detail: path.display().to_string(),
+                }
+            } else {
+                RuntimeToolStatus {
+                    ready: false,
+                    detail: "llama-server not found".to_string(),
+                }
+            }
+        }
+    };
+
+    let mlx_lm = match probe_env_executable(MLX_SERVER_ENV) {
+        Ok(Some(path)) => RuntimeToolStatus {
+            ready: true,
+            detail: format!("{} ({})", path.display(), MLX_SERVER_ENV),
+        },
+        Err(e) => RuntimeToolStatus {
+            ready: false,
+            detail: e,
+        },
+        Ok(None) => {
+            if let Some(path) = find_mlx_lm_server_path() {
+                RuntimeToolStatus {
+                    ready: true,
+                    detail: path.display().to_string(),
+                }
+            } else if let Some(py3) = find_binary_in_path("python3") {
+                if has_python_module("python3", "mlx_lm.server") {
+                    RuntimeToolStatus {
+                        ready: true,
+                        detail: format!("{} -m mlx_lm.server", py3.display()),
+                    }
+                } else {
+                    RuntimeToolStatus {
+                        ready: false,
+                        detail: format!(
+                            "{} found, but Python module mlx_lm.server is missing",
+                            py3.display()
+                        ),
+                    }
+                }
+            } else if let Some(py) = find_binary_in_path("python") {
+                if has_python_module("python", "mlx_lm.server") {
+                    RuntimeToolStatus {
+                        ready: true,
+                        detail: format!("{} -m mlx_lm.server", py.display()),
+                    }
+                } else {
+                    RuntimeToolStatus {
+                        ready: false,
+                        detail: format!(
+                            "{} found, but Python module mlx_lm.server is missing",
+                            py.display()
+                        ),
+                    }
+                }
+            } else {
+                RuntimeToolStatus {
+                    ready: false,
+                    detail: "mlx_lm.server launcher not found (no python3/python launcher)".to_string(),
+                }
+            }
+        }
+    };
+
+    let mlx_rs = match probe_env_executable(MLX_RS_SERVER_ENV) {
+        Ok(Some(path)) => RuntimeToolStatus {
+            ready: true,
+            detail: format!("{} ({})", path.display(), MLX_RS_SERVER_ENV),
+        },
+        Err(e) => RuntimeToolStatus {
+            ready: false,
+            detail: e,
+        },
+        Ok(None) => {
+            if let Some(path) = find_mlx_rs_server_in_path() {
+                RuntimeToolStatus {
+                    ready: true,
+                    detail: path.display().to_string(),
+                }
+            } else if mlx_lm.ready {
+                RuntimeToolStatus {
+                    ready: true,
+                    detail: format!("compat via {}", mlx_lm.detail),
+                }
+            } else {
+                RuntimeToolStatus {
+                    ready: false,
+                    detail: "mlx-rs launcher not found (mlx-lm compat unavailable)".to_string(),
+                }
+            }
+        }
+    };
+
+    LocalRuntimeProbe {
+        platform,
+        llama,
+        mlx_rs,
+        mlx_lm,
+    }
+}
