+fn fallback_request_model_id_from_path(selected_model_path: &Path) -> Option<String> {
+    let tail = selected_model_path.file_name()?.to_str()?.trim();
+    if !valid_repo_component(tail) {
+        return None;
+    }
+    let parent = selected_model_path
+        .parent()
+        .and_then(|p| p.file_name())
+        .and_then(|n| n.to_str())
+        .map(|s| s.trim().to_string());
+    if let Some(parent_name) = parent {
+        if parent_name.eq_ignore_ascii_case("models") {
+            return Some(tail.to_string());
+        }
+        if valid_repo_component(&parent_name) {
+            return Some(format!("{}/{}", parent_name, tail));
+        }
+    }
+    Some(tail.to_string())
