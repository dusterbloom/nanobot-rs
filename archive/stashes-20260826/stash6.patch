+fn format_model_size(bytes: u64) -> String {
+    if bytes < 1_048_576 {
+        "<1 MB".to_string()
+    } else {
+        format!("{} MB", bytes / 1_048_576)
+    }
+}
+
+fn model_size_label(path: &Path) -> String {
+    if let Ok(meta) = std::fs::metadata(path) {
+        return format_model_size(meta.len());
+    }
+    if let Ok(link_meta) = std::fs::symlink_metadata(path) {
+        if link_meta.file_type().is_symlink() {
+            if let Ok(target) = std::fs::read_link(path) {
+                let resolved = if target.is_absolute() {
+                    target
+                } else {
+                    path.parent()
+                        .unwrap_or_else(|| Path::new("/"))
+                        .join(target)
+                };
+                if let Ok(meta) = std::fs::metadata(&resolved) {
+                    return format_model_size(meta.len());
+                }
+                return "missing target".to_string();
+            }
+            return "broken symlink".to_string();
+        }
+    }
+    "unreadable".to_string()
+}
+
+fn is_supported_local_model_path(path: &Path) -> bool {
+    server::is_supported_local_model_path(path)
+}
+
+fn persisted_local_model_value(path: &Path) -> String {
+    let models_dir = dirs::home_dir()
+        .map(|h| h.join("models"))
+        .unwrap_or_default();
+    if path.starts_with(&models_dir) {
+        path.file_name()
+            .and_then(|n| n.to_str())
+            .map(|s| s.to_string())
+            .unwrap_or_else(|| path.display().to_string())
+    } else {
+        path.display().to_string()
+    }
+}
