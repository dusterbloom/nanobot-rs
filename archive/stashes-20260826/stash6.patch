+pub(crate) struct LocalModelListPolicy {
+    pub show_advanced_models: bool,
+    pub include_quarantined: bool,
+    pub quarantine_hours: u32,
+}
+
+impl LocalModelListPolicy {
+    pub(crate) fn from_config(local: &crate::config::schema::LocalModeConfig) -> Self {
+        Self {
+            show_advanced_models: local.show_advanced_models,
+            include_quarantined: false,
