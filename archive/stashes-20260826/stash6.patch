+pub(crate) fn cmd_local_check(fix: bool, yes: bool) {
+    if yes && !fix {
+        eprintln!("--yes requires --fix");
+        return;
+    }
+
+    let probe = print_local_runtime_probe(true);
+    if !fix {
+        return;
+    }
+
+    apply_local_runtime_fixes(&probe, yes);
+
+    println!("\nPost-fix preflight:");
+    let _ = print_local_runtime_probe(true);
+}
+
+fn print_local_runtime_probe(with_heading: bool) -> crate::server::LocalRuntimeProbe {
+    let probe = crate::server::local_runtime_probe();
+    if with_heading {
+        println!("\nLocal Runtime Preflight:");
+    } else {
+        println!("\n  Local runtime preflight:");
+    }
+    let prefix = if with_heading { "" } else { "  " };
+    let ok = |ready: bool| if ready { "ok" } else { "missing" };
+    println!("{prefix}  Host: {}", probe.platform.label());
+    println!(
+        "{prefix}  llama.cpp: {} ({})",
+        ok(probe.llama.ready),
+        probe.llama.detail
+    );
+    println!(
+        "{prefix}  mlx-rs: {} ({})",
+        ok(probe.mlx_rs.ready),
+        probe.mlx_rs.detail
+    );
+    println!(
+        "{prefix}  mlx-lm: {} ({})",
+        ok(probe.mlx_lm.ready),
+        probe.mlx_lm.detail
+    );
+
+    let fixes = crate::server::local_runtime_fix_commands(&probe);
+    if !fixes.is_empty() {
+        println!("{prefix}  Quick fixes:");
+        for cmd in fixes {
+            println!("{prefix}    - {}", cmd);
+        }
+    } else {
+        println!("{prefix}  Quick fixes: none needed");
+    }
+    probe
+}
+
+fn confirm_fix_step(prompt: &str, assume_yes: bool) -> bool {
+    if assume_yes {
+        return true;
+    }
+    print!("{prompt} [y/N] ");
+    io::stdout().flush().ok();
+    let mut input = String::new();
+    if io::stdin().read_line(&mut input).is_err() {
+        return false;
+    }
+    input.trim().eq_ignore_ascii_case("y")
+}
+
+fn find_python_launcher() -> Option<String> {
+    for bin in ["python3", "python"] {
+        let ok = Command::new(bin)
+            .arg("--version")
+            .stdout(std::process::Stdio::null())
+            .stderr(std::process::Stdio::null())
+            .status()
+            .map(|s| s.success())
+            .unwrap_or(false);
+        if ok {
+            return Some(bin.to_string());
+        }
+    }
+    None
+}
+
+fn has_brew() -> bool {
+    Command::new("brew")
+        .arg("--version")
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .status()
+        .map(|s| s.success())
+        .unwrap_or(false)
+}
+
+#[cfg(target_os = "macos")]
+fn is_macos() -> bool {
+    true
+}
+
+#[cfg(not(target_os = "macos"))]
+fn is_macos() -> bool {
+    false
+}
+
+fn apply_local_runtime_fixes(probe: &crate::server::LocalRuntimeProbe, assume_yes: bool) {
+    println!("\nApplying safe local fixes:");
+
+    if !probe.mlx_lm.ready {
+        let mut installed = false;
+        if is_macos() && has_brew() {
+            let cmd = "brew install mlx-lm";
+            if confirm_fix_step(&format!("  Run: {cmd}?"), assume_yes) {
+                match Command::new("brew").args(["install", "mlx-lm"]).status() {
+                    Ok(s) if s.success() => {
+                        println!("  Installed mlx-lm via Homebrew.");
+                        installed = true;
+                    }
+                    Ok(s) => println!("  brew install mlx-lm exited with status {}.", s),
+                    Err(e) => println!("  Failed to run brew install mlx-lm: {}", e),
+                }
+            } else {
+                println!("  Skipped brew mlx-lm install.");
+            }
+        }
+
+        if !installed {
+            if let Some(py) = find_python_launcher() {
+                let shell_cmd = if is_macos() {
+                    format!(
+                        "{py} -m pip install --user --break-system-packages --upgrade pip mlx-lm"
+                    )
+                } else {
+                    format!("{py} -m pip install --upgrade pip mlx-lm")
+                };
+                if confirm_fix_step(&format!("  Run: {shell_cmd}?"), assume_yes) {
+                    let status = if is_macos() {
+                        Command::new(&py)
+                            .args([
+                                "-m",
+                                "pip",
+                                "install",
+                                "--user",
+                                "--break-system-packages",
+                                "--upgrade",
+                                "pip",
+                                "mlx-lm",
+                            ])
+                            .status()
+                    } else {
+                        Command::new(&py)
+                            .args(["-m", "pip", "install", "--upgrade", "pip", "mlx-lm"])
+                            .status()
+                    };
+                    match status {
+                        Ok(s) if s.success() => println!("  Installed mlx-lm successfully."),
+                        Ok(s) => println!("  mlx-lm install exited with status {}.", s),
+                        Err(e) => println!("  Failed to run pip install: {}", e),
+                    }
+                } else {
+                    println!("  Skipped mlx-lm pip install.");
+                }
+            } else {
+                println!("  No python launcher found; cannot auto-install mlx-lm.");
+            }
+        }
+    }
+
+    if !probe.llama.ready {
+        if confirm_fix_step(
+            "  Bootstrap llama.cpp (clone/build llama-server) now?",
+            assume_yes,
+        ) {
+            match crate::server::resolve_llama_server_path() {
+                Ok(path) => println!("  llama-server ready at {}", path.display()),
+                Err(e) => println!("  llama.cpp setup failed: {}", e),
+            }
+        } else {
+            println!("  Skipped llama.cpp bootstrap.");
+        }
+    }
+
+    if !probe.mlx_rs.ready {
+        println!(
+            "  mlx-rs: launcher missing. Install mlx-lm for compatibility or set NANOBOT_MLX_RS_SERVER to a native launcher path."
+        );
+    }
 }
 
