+fn persisted_local_model_value(path: &Path) -> String {
+    let models_dir = dirs::home_dir()
+        .map(|h| h.join("models"))
+        .unwrap_or_default();
+    if path.starts_with(&models_dir) {
+        path.file_name()
+            .and_then(|n| n.to_str())
+            .map(|s| s.to_string())
+            .unwrap_or_else(|| path.display().to_string())
+    } else {
+        path.display().to_string()
+    }
+}
+
+fn is_supported_local_model_path(path: &Path) -> bool {
+    server::is_supported_local_model_path(path)
+}
+
+fn resolve_startup_local_model_path(
+    saved_local_model: &str,
+    models_dir: &Path,
+    local_cfg: &LocalModeConfig,
+) -> Option<std::path::PathBuf> {
+    let saved = saved_local_model.trim();
+    let saved_path = if saved.is_empty() {
+        None
+    } else {
+        let p = std::path::Path::new(saved);
+        Some(if p.is_absolute() {
+            p.to_path_buf()
+        } else {
+            models_dir.join(saved)
+        })
+    };
+    let default_path = models_dir.join(server::DEFAULT_LOCAL_MODEL);
+    let policy = server::LocalModelListPolicy::from_config(local_cfg);
+    let selectable = server::list_selectable_local_models_with_policy(policy);
+    let first_selectable = selectable.first().cloned();
+    let first_mlx = selectable
+        .iter()
+        .find(|p| server::normalize_mlx_model_path(p).is_some())
+        .cloned();
+
+    let saved_supported = saved_path.filter(|p| {
+        if !is_supported_local_model_path(p) {
+            return false;
+        }
+        if server::normalize_mlx_model_path(p).is_some() {
+            if !local_cfg.show_advanced_models
+                && server::classify_mlx_model(p) != server::MlxModelClass::ChatSafe
+            {
+                return false;
+            }
+            let backend = server::backend_label_for_model(p);
+            return !server::is_model_quarantined(
+                p,
+                backend,
+                local_cfg.failed_model_quarantine_hours,
+            );
+        }
+        true
+    });
+    let default_supported = if is_supported_local_model_path(&default_path) {
+        Some(default_path.clone())
+    } else {
+        None
+    };
+
+    if server::prefer_mlx_model_selection() {
+        let saved_mlx = saved_supported
+            .as_ref()
+            .filter(|p| server::normalize_mlx_model_path(p).is_some())
+            .cloned();
+        saved_mlx
+            .or(first_mlx)
+            .or(saved_supported)
+            .or(default_supported)
+            .or(first_selectable)
+    } else {
+        saved_supported.or(default_supported).or(first_selectable)
+    }
+}
