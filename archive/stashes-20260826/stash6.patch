+fn valid_repo_component(s: &str) -> bool {
+    let t = s.trim();
+    if t.is_empty() || t.len() > 96 {
+        return false;
+    }
+    if t.starts_with('-') || t.starts_with('.') || t.ends_with('-') || t.ends_with('.') {
+        return false;
+    }
+    t.chars()
+        .all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_' || c == '.')
+}
