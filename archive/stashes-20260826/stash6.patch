+    match env_pref.as_str() {
+        "llama" | "llama.cpp" | "llamacpp" => LocalBackend::LlamaCpp,
+        "mlx-rs" | "mlxrs" => LocalBackend::MlxRs,
+        "mlx-lm" | "mlxlm" => LocalBackend::MlxLm,
