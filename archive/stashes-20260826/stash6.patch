+fn voice_has_tool_intent(text: &str) -> bool {
+    let t = text.to_ascii_lowercase();
+    let toolish_terms = [
+        "file", "files", "folder", "directory", "workspace", "code", "shell", "command",
+        "run ", "execute ", "search", "web", "url", "email", "inbox", "telegram",
+        "whatsapp", "audit", "verify", "memory", "context", "status", "restart", "git",
+        "spawn", "subagent", "delegate", "delegation", "news", "headline", "latest",
+    ];
+    toolish_terms.iter().any(|k| t.contains(k))
+}
+
+fn is_small_talk_message(text: &str) -> bool {
+    let normalized = text
+        .trim()
+        .trim_matches(|c: char| c.is_ascii_punctuation() || c.is_ascii_whitespace())
+        .to_ascii_lowercase();
+    if normalized.is_empty() || normalized.len() > 32 {
+        return false;
+    }
+    matches!(
+        normalized.as_str(),
+        "hi"
+            | "hello"
+            | "hey"
+            | "yo"
+            | "how are you"
+            | "how are you doing"
+            | "how are things"
+            | "thanks"
+            | "thank you"
+            | "ok"
+            | "okay"
+            | "cool"
+            | "nice"
+            | "sup"
+            | "howdy"
+    )
+}
+
+fn is_short_non_tool_prompt(text: &str) -> bool {
+    let trimmed = text.trim();
+    if trimmed.is_empty() || trimmed.len() > 80 {
+        return false;
+    }
+    // Keep this conservative: short, human-language prompts only.
+    trimmed
+        .chars()
+        .all(|c| c.is_ascii_alphanumeric() || c.is_ascii_whitespace() || ".,!?'-".contains(c))
+}
+
+fn should_fast_chat(channel: &str, text: &str) -> bool {
+    if voice_has_tool_intent(text) {
+        return false;
+    }
+    if channel == "voice" {
+        return is_small_talk_message(text) || is_short_non_tool_prompt(text);
+    }
+    // For text channels, keep the fast path strict to avoid suppressing tool
+    // usage for short but actionable prompts (e.g. "use subagents please").
+    is_small_talk_message(text)
+}
+
+fn is_transient_llm_error_message(text: &str) -> bool {
+    let trimmed = text.trim();
+    trimmed.starts_with("[LLM Error]")
+        || trimmed.starts_with("I encountered an error:")
+        || trimmed == "I encountered a streaming error."
+        || trimmed.contains("<think>")
+        || trimmed.contains("</think>")
+        || trimmed.contains("<thinking>")
+        || trimmed.contains("</thinking>")
+        || trimmed.contains("<|channel|>")
+        || trimmed.contains("<|channel")
+        || trimmed.contains("<|message|>")
+        || trimmed.contains("<|message")
+        || trimmed.contains("<|start|>")
+        || trimmed.contains("<|start")
+        || trimmed.contains("<|end|>")
+        || trimmed.contains("<|end")
+}
+
+fn normalize_local_request_model_alias(model: &str) -> Option<String> {
+    let trimmed = model.trim();
+    if trimmed.is_empty() {
+        return None;
+    }
+    if let Some(rest) = trimmed.strip_prefix("local:") {
+        let stripped = rest.trim();
+        if stripped.is_empty() {
+            None
+        } else {
+            Some(stripped.to_string())
+        }
+    } else {
+        Some(trimmed.to_string())
+    }
+}
+
+fn effective_request_model_for_call(core: &SwappableCore) -> String {
+    if let Some(ref req) = core.request_model {
+        if let Some(model) = normalize_local_request_model_alias(req) {
+            return model;
+        }
+    }
+    if let Some(model) = normalize_local_request_model_alias(&core.display_model) {
+        return model;
+    }
+    core.display_model.clone()
+}
+
+fn normalize_signature_value(value: &Value) -> Value {
+    match value {
+        Value::Object(map) => {
+            let mut sorted = serde_json::Map::with_capacity(map.len());
+            let mut keys: Vec<&String> = map.keys().collect();
+            keys.sort();
+            for key in keys {
+                if let Some(v) = map.get(key) {
+                    sorted.insert(key.clone(), normalize_signature_value(v));
+                }
+            }
+            Value::Object(sorted)
+        }
+        Value::Array(items) => Value::Array(
+            items
+                .iter()
+                .map(normalize_signature_value)
+                .collect::<Vec<_>>(),
+        ),
+        _ => value.clone(),
+    }
+}
+
+fn tool_call_batch_signature(tool_calls: &[ToolCallRequest]) -> String {
+    let mut parts = Vec::with_capacity(tool_calls.len());
+    for tc in tool_calls {
+        let mut args = BTreeMap::new();
+        for (k, v) in &tc.arguments {
+            args.insert(k.clone(), normalize_signature_value(v));
+        }
+        let args_json = serde_json::to_string(&args).unwrap_or_else(|_| "{}".to_string());
+        parts.push(format!("{}:{}", tc.name, args_json));
+    }
+    parts.join("|")
+}
