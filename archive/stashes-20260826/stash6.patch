+fn probe_env_executable(env_var: &str) -> Result<Option<PathBuf>, String> {
+    let value = match std::env::var(env_var) {
+        Ok(v) => v,
+        Err(_) => return Ok(None),
+    };
+    let trimmed = value.trim();
+    if trimmed.is_empty() {
+        return Err(format!("{env_var} is set but empty"));
+    }
+    let path = PathBuf::from(trimmed);
+    if path.is_file() {
+        Ok(Some(path))
+    } else {
+        Err(format!("{env_var} points to missing file: {}", path.display()))
+    }
+}
