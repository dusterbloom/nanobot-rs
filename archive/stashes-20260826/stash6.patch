+            HostPlatform::MacOs => out.push(
+                "brew install cmake git && git clone https://github.com/ggerganov/llama.cpp ~/llama.cpp && cmake -S ~/llama.cpp -B ~/llama.cpp/build -DLLAMA_BUILD_SERVER=ON -DCMAKE_BUILD_TYPE=Release && cmake --build ~/llama.cpp/build --target llama-server -j 8".to_string(),
+            ),
+            HostPlatform::Linux | HostPlatform::Wsl => out.push(
+                "sudo apt-get update && sudo apt-get install -y build-essential cmake git && git clone https://github.com/ggerganov/llama.cpp ~/llama.cpp && cmake -S ~/llama.cpp -B ~/llama.cpp/build -DLLAMA_BUILD_SERVER=ON -DCMAKE_BUILD_TYPE=Release && cmake --build ~/llama.cpp/build --target llama-server -j 8".to_string(),
+            ),
+            HostPlatform::Other => out.push(
+                "Install llama.cpp with llama-server and set NANOBOT_LLAMA_SERVER=/absolute/path/to/llama-server".to_string(),
+            ),
+        }
+    }
+    if !probe.mlx_lm.ready {
+        match probe.platform {
+            HostPlatform::MacOs => {
+                out.push("brew install mlx-lm".to_string());
+                out.push(
+                    "python3 -m pip install --user --break-system-packages --upgrade pip mlx-lm"
+                        .to_string(),
+                );
+            }
+            _ => out.push("python3 -m pip install --upgrade pip mlx-lm".to_string()),
+        }
+    }
+    if !probe.mlx_rs.ready {
+        out.push(
+            "mlx-rs launcher not found. Install mlx-lm for compatibility or set NANOBOT_MLX_RS_SERVER=/absolute/path/to a native launcher.".to_string(),
+        );
+    }
+    out
+}
